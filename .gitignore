# Зависимости (устанавливаются автоматически на сервере при деплое)
node_modules/

# Локальные переменные окружения и логи
.env
npm-debug.log*

# Временные журналы и резервные копии SQLite
prisma/dev.db-wal
prisma/dev.db-shm
prisma/dev.db-journal
prisma/*.corrupted.bak

# Временные файлы хранилища
storage/history/*
!storage/history/.gitkeep

# Системные файлы ОС
.DS_Store
Thumbs.db
