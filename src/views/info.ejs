<%- include('partials/header') %>

<div class="page-title">
  <h1><%= info.title %></h1>
  <p><%= info.subtitle %></p>
</div>

<div class="info-page-card">
  <% info.sections.forEach(sec => { %>
    <div class="info-section">
      <h3><%= sec.heading %></h3>
      <p><%= sec.text %></p>
    </div>
  <% }) %>
</div>

<%- include('partials/footer') %>
