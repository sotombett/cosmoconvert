<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>CosmoConvert — Мультимедийная студия</title>
  <script>
    (function() {
      var t = localStorage.getItem('cosmoconvert_theme');
      if (t === 'light') document.documentElement.setAttribute('data-theme', 'light');
    })();
  </script>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header>
    <a href="/home" class="brand">
      <div class="brand-mark">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="4"/>
          <ellipse cx="12" cy="12" rx="10" ry="4.5" transform="rotate(-30 12 12)"/>
        </svg>
      </div>
      <div>Cosmo<span>Convert</span></div>
    </a>

    <nav class="nav-tabs">
      <!-- 1. Конвертация -->
      <a href="/convert" class="nav-link <%= activePage === 'convert' ? 'active' : '' %>">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
        Конвертация
      </a>

      <!-- 2. Изображения (ресайз, пропорции, симметрия и апскейл) -->
      <a href="/images/process" class="nav-link <%= activePage === 'image_process' ? 'active' : '' %>">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
        Изображения
      </a>

      <!-- 3. Аудио -->
      <a href="/audio" class="nav-link <%= activePage === 'audio' ? 'active' : '' %>">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
        Аудио
      </a>

      <!-- 4. Видео (выпадающий список: Извлечь аудио) -->
      <div class="nav-dropdown">
        <button type="button" class="nav-link <%= activePage === 'video_extract' ? 'active' : '' %>" onclick="toggleNavDropdown(this)">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
          Видео
          <svg class="chevron-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="dropdown-menu">
          <a href="/video/extract-audio" class="dropdown-item <%= activePage === 'video_extract' ? 'active' : '' %>">
            <span class="dropdown-item-title">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
              Извлечь аудио
            </span>
            <span class="dropdown-item-desc">Выделить MP3 / WAV дорожку из видео</span>
          </a>
        </div>
      </div>

      <!-- 5. Метаданные (отдельный раздел для изображений, аудио, видео и документов) -->
      <a href="/metadata" class="nav-link <%= activePage === 'metadata' ? 'active' : '' %>">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        Метаданные
      </a>
    </nav>

    <div class="account-area">
      <button type="button" class="theme-toggle-btn" id="themeToggleBtn" onclick="toggleSiteTheme()" title="Переключить тему (Тёмная / Светлая)">
        <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>

      <% if (user) { %>
        <% if (isAdmin) { %>
          <div class="credits-pill admin-pill" title="Учетная запись администратора — безлимитный доступ">ADMIN • <b>∞</b></div>
        <% } else { %>
          <div class="credits-pill">Кредиты: <b id="headerCredits"><%= user.credits %>/<%= dailyLimit %></b></div>
        <% } %>
        <a href="/profile" class="btn-top outline <%= activePage === 'profile' ? 'active' : '' %>"><%= user.email %></a>
        <form action="/logout" method="POST" style="display:inline;">
          <button type="submit" class="btn-top outline">Выйти</button>
        </form>
      <% } else { %>
        <div class="guest-limit-wrap">
          <div class="credits-pill" title="Пробные действия без регистрации">Гость: <b id="headerCredits"><%= guestRemaining %>/<%= guestLimit %></b></div>
          <button type="button" class="limit-edit-btn" onclick="openGuestLimitModal()">Изменить лимит</button>
        </div>
        <a href="/login" class="btn-top outline">Войти</a>
        <a href="/register" class="btn-top">Регистрация</a>
      <% } %>
    </div>
  </header>

  <script>
    function toggleSiteTheme() {
      const root = document.documentElement;
      const isLight = root.getAttribute('data-theme') === 'light';
      if (isLight) {
        root.removeAttribute('data-theme');
        localStorage.setItem('cosmoconvert_theme', 'dark');
      } else {
        root.setAttribute('data-theme', 'light');
        localStorage.setItem('cosmoconvert_theme', 'light');
      }
      window.dispatchEvent(new Event('cosmoconvert-theme-change'));
    }

    function toggleNavDropdown(btn) {
      const parent = btn.closest('.nav-dropdown');
      const wasOpen = parent.classList.contains('open');
      document.querySelectorAll('.nav-dropdown.open').forEach(el => el.classList.remove('open'));
      if (!wasOpen) parent.classList.add('open');
    }

    document.addEventListener('click', (e) => {
      if (!e.target.closest('.nav-dropdown')) {
        document.querySelectorAll('.nav-dropdown.open').forEach(el => el.classList.remove('open'));
      }
    });
  </script>

  <% if (!user) { %>
    <div class="custom-modal-backdrop hidden" id="guestLimitModal" onclick="if(event.target === this) closeGuestLimitModal()">
      <div class="custom-modal">
        <div class="custom-modal-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/>
            <line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/>
            <line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/>
            <line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/>
          </svg>
        </div>
        <h3>Настройка лимита гостя</h3>
        <p>Выберите действие для быстрой проверки работы гостевых попыток и окна ограничения:</p>
        <div class="limit-choice-group">
          <button type="button" class="limit-choice-btn reset" onclick="changeGuestLimit('reset')">
            <span class="choice-title">Сброс лимита (4/4)</span>
            <span class="choice-desc">Восстановить все пробные попытки</span>
          </button>
          <button type="button" class="limit-choice-btn zero" onclick="changeGuestLimit('zero')">
            <span class="choice-title">Обнуление лимита (0/4)</span>
            <span class="choice-desc">Исчерпать попытки для теста предупреждения</span>
          </button>
        </div>
        <button type="button" class="modal-cancel-btn" onclick="closeGuestLimitModal()">Отмена</button>
      </div>
    </div>

    <script>
      function openGuestLimitModal() {
        document.getElementById('guestLimitModal').classList.remove('hidden');
      }
      function closeGuestLimitModal() {
        document.getElementById('guestLimitModal').classList.add('hidden');
      }
      async function changeGuestLimit(action) {
        const res = await fetch('/api/guest-limit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action })
        });
        if (res.ok) {
          const data = await res.json();
          const creditsEl = document.getElementById('headerCredits');
          if (creditsEl) creditsEl.textContent = data.display;
          closeGuestLimitModal();
        }
      }
    </script>
  <% } %>

  <main>
